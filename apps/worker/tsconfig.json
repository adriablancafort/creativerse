{
  "compilerOptions": {
    "target": "ES2023",
    "types": ["node"],
    "skipLibCheck": true,
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "rolldown.config.ts"]
}
